# Normalize line endings in the repo, check out native on Windows.
* text=auto eol=lf

*.rs   text eol=lf
*.toml text eol=lf
*.md   text eol=lf
*.yml  text eol=lf

# Windows scripts must keep CRLF
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binary assets
*.ico  binary
*.png  binary
*.jpg  binary
*.onnx binary